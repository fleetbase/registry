APP_NAME=Registry
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# sqlite for a zero-dependency local run; docker-compose overrides this with mysql.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=registry
# DB_USERNAME=registry
# DB_PASSWORD=registry

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
QUEUE_CONNECTION=database
CACHE_STORE=database
# CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Verification codes go out by mail. Mailpit (docker compose) listens on 1025 / UI on 8025.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="registry@fleetbase.local"
MAIL_FROM_NAME="${APP_NAME}"

# Package store. Local disk by default; S3 / MinIO in docker and production.
FILESYSTEM_DISK=local
REGISTRY_STORAGE_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=fleetbase-registry
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

# registry:import reads cloud bundle and icon objects from this disk (an s3 disk by default).
REGISTRY_IMPORT_SOURCE_DISK=import_source
IMPORT_SOURCE_AWS_BUCKET=
# IMPORT_SOURCE_AWS_ACCESS_KEY_ID=
# IMPORT_SOURCE_AWS_SECRET_ACCESS_KEY=
# IMPORT_SOURCE_AWS_DEFAULT_REGION=

# Registry
REGISTRY_VERSION=2.0.0-dev
REGISTRY_CATALOG_CACHE_SECONDS=60
# Base URL written into npm/Composer metadata; empty = the request's scheme and host.
REGISTRY_PUBLIC_URL=
REGISTRY_PACKAGE_METADATA_CACHE_SECONDS=60
HASH_VERIFY=true

# Release pipeline limits and the secrets scanner (auto | builtin | off).
# REGISTRY_MAX_BUNDLE_BYTES=52428800
# REGISTRY_MAX_DIST_BYTES=104857600
# REGISTRY_MAX_UNPACKED_BYTES=314572800
# REGISTRY_MAX_FILE_BYTES=26214400
# REGISTRY_MAX_ARCHIVE_ENTRIES=20000
REGISTRY_SECRETS_SCANNER=auto
# REGISTRY_GITLEAKS_BINARY=gitleaks
# REGISTRY_CHECKS_QUEUE=

# Sentry (optional)
SENTRY_LARAVEL_DSN=
