# Copy to .env (git-ignored). docker compose reads it for ${VAR} substitution in
# docker-compose.override.yml. Keep real values out of git.
AWS_BUCKET=
AWS_KEY_PREFIX=fleetbase-extensions
AWS_REGION=ap-southeast-1
AWS_ENDPOINT=http://s3.ap-southeast-1.amazonaws.com
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
FLEETBASE_HOST=http://application:8000
FLEETBASE_API_KEY=
DEV_REWRITE_MINIO_HOST=0
